# ─── advisor_tokens.yaml.example ────────────────────────────────────────────
#
# Plantilla de tokens de advisor para Fase 2 (development-only).
#
# Cómo usar:
#   1. Copiar a `config/advisor_tokens.yaml` (gitignored).
#   2. Reemplazar valores demo por tokens reales del entorno.
#   3. Apuntar el backend con ENV var ADVISOR_TOKENS_FILE si el path no
#      es el default (ej. para CI/staging).
#
# Resolución del loader (src/risk_first_advisory/config_layer/advisor_tokens.py):
#   1. ENV var ADVISOR_TOKENS_FILE        → ese archivo.
#   2. config/advisor_tokens.yaml         → ese archivo.
#   3. Fallback hardcoded development-only → los dos tokens de abajo.
#
# Cuando se usa (1) o (2), el archivo REEMPLAZA por completo al fallback —
# no hay merge. Los tokens dev-* no resuelven si el env var/archivo apunta
# a un YAML que no los lista.
#
# Schema:
#   - tokens: dict requerido (top-level).
#   - cada entry requiere advisor_id, display_name, firm_id, roles.
#   - firm_id puede ser null (single-firm dev) o str no vacío.
#   - roles: list[str] no vacía. Valores válidos: advisor, compliance, admin, viewer.
#   - cualquier campo desconocido → ValueError (fail-loud).
#
# Seguridad:
#   - NUNCA commitear el archivo real con tokens usables. Solo el .example.
#   - Los tokens son opaque strings — el loader no los rota ni los firma.
#   - Esto NO reemplaza JWT/IdP. Es scaffold para piloto local 1–3 advisors.
# ────────────────────────────────────────────────────────────────────────────

tokens:
  dev-advisor-token:
    advisor_id: ADV-001
    display_name: Demo Advisor
    firm_id: null
    roles:
      - advisor

  dev-compliance-token:
    advisor_id: CMP-001
    display_name: Demo Compliance
    firm_id: null
    roles:
      - compliance
